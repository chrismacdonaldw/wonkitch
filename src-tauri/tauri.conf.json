{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wonkitch",
  "version": "0.1.0",
  "identifier": "com.chrismacdonaldw.wonkitch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wonkitch",
        "width": 1600,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 620,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* http://127.0.0.1:* wss://irc-ws.chat.twitch.tv https://7tv.io https://api.betterttv.net https://api.frankerfacez.com https://api.ivr.fi; img-src 'self' data: https://cdn.7tv.app https://cdn.betterttv.net https://cdn.frankerfacez.com https://static-cdn.jtvnw.net; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQTY5RDdENTQzRkJGODcKUldTSHZ6OVVmWjJtZ2VJWk1ielZpbmR5TEhBYUdSOUFiL1VVODZQUXVDVEhTYWxXTEtpdGg3WUcK",
      "endpoints": [
        "https://github.com/chrismacdonaldw/wonkitch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
